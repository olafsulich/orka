# Copy to <repo>/.orka/secrets/finish-webhook.env (or .orca/secrets/ in a repo from before the rename) and chmod 600.
# Not a shell script. Assignments only. Do not commit the copy.
# Same keys as herdr-finish-wake.env, so that URL and key can be reused.
# WEBHOOK_KEY is the raw token, not a "Bearer " prefix.
WEBHOOK_URL=https://example.invalid/automations/webhook/REPLACE_ME
WEBHOOK_KEY=REPLACE_ME
